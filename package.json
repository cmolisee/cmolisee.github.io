{
  "name": "cmolisee",
  "version": "2026.3.29",
  "description": "",
  "type": "module",
  "scripts": {
    "build:css:prod": "NODE_ENV=production postcss assets/_css/main.css -o assets/css/main.css --trace-deprecation",
    "build:css": "NODE_ENV=development postcss assets/_css/main.css -o assets/css/main.css",
    "build:jekyll:prod": "JEKYLL_ENV=production bundle exec jekyll build",
    "build:jekyll": "bundle exec jekyll build",
    "build:ts:prod": "esbuild assets/_ts/main.ts --bundle --outfile=assets/js/main.js --format=esm --target=es2020 --minify",
    "build:ts": "esbuild assets/_ts/main.ts --bundle --outfile=assets/js/main.js --format=esm --target=es2020 --sourcemap",
    "build": "npm run build:css:prod && npm run build:ts:prod && npm run build:jekyll:prod",
    "dev": "npm run build:jekyll && npm run build:css && npm run build:ts && concurrently --names \"css,ts,jekyll\" --prefix-colors \"cyan,yellow,magenta\" \"npm run watch:css\" \"npm run watch:ts\" \"npm run watch:jekyll\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,html,css}\"",
    "format:md:check": "prettier --check \"**/*.md\"",
    "format:md": "prettier --write \"**/*.md\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,html,css}\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:fix": "eslint . --fix",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint": "eslint .",
    "prepare": "husky",
    "watch:css": "postcss assets/_css/main.css -o assets/css/main.css --watch --trace-deprecation",
    "watch:jekyll": "bundle exec jekyll serve --incremental",
    "watch:ts": "esbuild assets/_ts/main.ts --bundle --outfile=assets/js/main.js --format=esm --target=es2020 --sourcemap --watch"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.css": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write",
      "markdownlint-cli2 --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@shopify/prettier-plugin-liquid": "^1.10.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.5.2",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cssnano": "^7.1.4",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "htmlhint": "^1.9.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.22.0",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-markdown": "^1.3.1",
    "postcss-nesting": "^14.0.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.2.2",
    "typescript-eslint": "^8.58.0"
  }
}
