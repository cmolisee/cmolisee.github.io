{
  "name": "cmolisee",
  "version": "2026.3.29",
  "description": "",
  "type": "module",
  "scripts": {
    "build:css": "postcss assets/css/main.css -o _site/assets/css/main.css --config postcss.config.js",
    "watch:css": "postcss assets/css/main.css -o _site/assets/css/main.css --config postcss.config.js --watch --trace-deprecation",
    "build:jekyll": "bundle exec jekyll build",
    "watch:jekyll": "bundle exec jekyll serve --watch --livereload",
    "build": "npm run build:css && npm run build:jekyll",
    "dev": "concurrently \"npm run watch:css\" \"npm run watch:jekyll\"",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:html": "htmlhint _site/**/*.html",
    "lint:css": "stylelint assets/css/**/*.css",
    "lint": "npm run lint:js && npm run lint:css",
    "format": "prettier --write \"assets/js/**/*.js\" \"assets/css/**/*.css\" \"_includes/**/*.html\" \"_layouts/**/*.html\"",
    "format:check": "prettier --check \"assets/js/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "htmlhint": "^1.9.2",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "postcss-html": "^1.8.1",
    "postcss-markdown": "^1.3.1",
    "prettier": "^3.8.1",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.2",
    "typescript-eslint": "^8.58.0"
  }
}
